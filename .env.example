# Copy this file to .env and edit it. .env is git-ignored; never commit it.

# Host dashboard PIN (4-32 characters, no spaces). Change it before the party.
HOST_PIN=changeme

# Shown on the TV header, the join page and the highlights video title card.
# Separate several hosts with commas: HOST_NAMES="Asha, Ravi & Tara"
HOST_NAMES="Your Family"
PARTY_NAME="Diwali Night"

# White-wall backdrop swap in the photo editor (off by default).
BACKDROP_ENABLED=false

# AI touches (titles, captions, commentary) via the Claude Code CLI.
# Set to false to always use the built-in presets.
AI_ENABLED=true

# Optional
# PORT=3000
# AI_MODEL=haiku
